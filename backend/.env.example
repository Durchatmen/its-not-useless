# ---------- 应用 ----------
APP_ENV=dev
APP_NAME=hospital-ai
TZ=Asia/Shanghai

# ---------- 认证 ----------
# 必填：PyJWT 的 HS256 密钥，至少 32 字节。生产环境用 openssl rand -hex 32 生成并妥善保管。
# 注意：身份证号密文由本密钥派生，更换后已落库的身份证号将无法解密（见 app/core/crypto.py）
SECRET_KEY=请用 openssl rand -hex 32 生成 32 字节随机串后替换
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---------- 数据库（ORM，无迁移）----------
DATABASE_URL=mysql+pymysql://root:123456@192.168.37.19:3306/hospital_ai?charset=utf8mb4
DB_ECHO=false

# ---------- Redis（缓存 / Celery broker）----------
REDIS_URL=redis://192.168.37.13:6379/0
CELERY_BROKER_URL=redis://192.168.37.13:6379/1
CELERY_RESULT_BACKEND=redis://192.168.37.13:6379/2

# ---------- Milvus（六大知识库）----------
MILVUS_HOST=192.168.37.13
MILVUS_PORT=19530

# ---------- Embedding（BGE-M3）----------
# 本地权重目录（含 config.json，零下载）或 ModelScope 模型 id（首次会下载）
EMBEDDING_MODEL=D:/Project/models/bge_m3
EMBEDDING_DEVICES=cpu

# ---------- Reranker（BGE-reranker-large）----------
RERANKER_MODEL=D:/Project/models/bge-reranker-large
RERANKER_DEVICES=cpu

# ---------- 对象存储 ----------
MINIO_ENDPOINT=192.168.37.13:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hospital-files
MINIO_SECURE=false


# ---------- 高德 ----------
AMAP_WEB_KEY=

# ---------- 大模型（Qwen / 百炼 OpenAI 兼容端点）----------
# 百炼的兼容端点；自建 vLLM 时改成对应内网地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼控制台申请；填入后 AI 链路才能联调

LLM_API_KEY=
LLM_MODEL=qwen-plus
# 图片理解 / OCR 的视觉模型（可换 qwen3-vl-plus / qwen-vl-max）
LLM_VL_MODEL=qwen-vl-plus
# 语音转写的全模态模型（不支持 amr，需先转 wav/mp3）
LLM_OMNI_MODEL=qwen-omni-turbo

# ---------- 支付沙箱 ----------
WECHAT_PAY_SANDBOX_APPID=
WECHAT_PAY_SANDBOX_MCHID=
WECHAT_PAY_SANDBOX_KEY=
ALIPAY_SANDBOX_APPID=
ALIPAY_SANDBOX_PRIVATE_KEY=

# ---------- HIS 对接（开发期本地模拟）----------
HIS_BASE_URL=http://127.0.0.1:8001/mock
HIS_ENABLED=false

# ---------- 短信网关（注册/登录验证码，接口文档 3.1.3）----------
# 留空时验证码只写日志（开发模式），不会真正发短信
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SIGN_NAME=智慧医疗
SMS_TIMEOUT=8
# 验证码有效期（分钟）与同号同场景重发间隔（秒）
SMS_CODE_TTL_MINUTES=5
SMS_RESEND_SECONDS=60

# ---------- 医院与院外导航（接口文档 API-20）----------
HOSPITAL_CODE=H0001
HOSPITAL_NAME=示范医院
HOSPITAL_LATITUDE=30.274084
HOSPITAL_LONGITUDE=120.155070
# 医院主入口坐标；留 0 时回落到医院坐标
HOSPITAL_GATE_LATITUDE=0
HOSPITAL_GATE_LONGITUDE=0

# ---------- 高德开放平台 ----------
# Web 服务 Key（路径规划/POI/静态图）；留空时院外导航直接返回 5004
AMAP_WEB_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_CITY=杭州
AMAP_TIMEOUT=8
