# ---------- 应用 ----------
APP_ENV=dev
APP_NAME=hospital-ai
TZ=Asia/Shanghai

# ---------- 认证 ----------
# 生产环境务必替换，用 openssl rand -hex 32 生成
SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---------- 数据库（ORM，无迁移）----------
DATABASE_URL=mysql+pymysql://root:root123456@192.168.37.45:3306/hospital_ai?charset=utf8mb4
DB_ECHO=false

# ---------- Redis（缓存 / Celery broker）----------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------- Milvus（六大知识库）----------
MILVUS_HOST=127.22.0.4
MILVUS_PORT=19529

# ---------- 对象存储 ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hospital-files
MINIO_SECURE=false

# ---------- 高德 ----------
AMAP_WEB_KEY=

# ---------- 大模型（服务商待选型，见文档 §8）----------
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=qwen

# ---------- 支付沙箱 ----------
WECHAT_PAY_SANDBOX_APPID=
WECHAT_PAY_SANDBOX_MCHID=
WECHAT_PAY_SANDBOX_KEY=
ALIPAY_SANDBOX_APPID=
ALIPAY_SANDBOX_PRIVATE_KEY=

# ---------- HIS 对接（开发期本地模拟）----------
HIS_BASE_URL=http://127.0.0.1:8001/mock
HIS_ENABLED=false
